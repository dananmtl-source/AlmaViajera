:root {
    color-scheme: light;
    --color-ink: #183b35;
    --color-muted: #61736e;
    --color-primary: #236b57;
    --color-primary-dark: #174c3d;
    --color-accent: #e8a95b;
    --color-surface: #ffffff;
    --color-background: #f5f7f2;
    --color-border: #dce5dc;
    --shadow-card: 0 12px 32px rgb(24 59 53 / 8%);
    font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
}

* {
    box-sizing: border-box;
}

html {
    min-width: 320px;
    background: var(--color-background);
}

body.gridBase {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    color: var(--color-ink);
    background: var(--color-background);
}

a {
    color: inherit;
}

.cabecera {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 82px;
    padding: 0.8rem clamp(1rem, 5vw, 4rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
}

.cabecera > img {
    display: block;
    width: 46px;
    height: 46px;
    object-fit: contain;
}

.logo {
    color: var(--color-primary-dark);
    font-size: 1.3rem;
    font-weight: 750;
    letter-spacing: -0.035em;
    text-decoration: none;
    white-space: nowrap;
}

.menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 2.3vw, 2rem);
    margin: 0 auto;
}

.menu a {
    padding: 0.55rem 0.1rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
}

.menu a:hover,
.menu a:focus-visible {
    color: var(--color-primary);
}

.botonViaje,
.filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    color: #fff;
    background: var(--color-primary);
    border: 0;
    border-radius: 0.7rem;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms ease;
}

.botonViaje:hover,
.filter:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
}

.botonViaje:focus-visible,
.filter:focus-visible,
.menu a:focus-visible,
.nav-links a:focus-visible,
.menu-toggle:focus-visible,
.destino:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
}

main {
    width: min(100% - 2rem, 1080px);
    flex: 1;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 3.75rem) 0;
}

#nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
}

.language-selector {
    position: relative;
}

.menu-toggle {
    min-height: 40px;
    padding: 0.5rem 0.85rem;
    color: var(--color-primary-dark);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
}

.menu-toggle::-webkit-details-marker {
    display: none;
}

.nav-links {
    position: absolute;
    z-index: 1;
    top: calc(100% + 0.35rem);
    right: 0;
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
    box-shadow: var(--shadow-card);
    list-style: none;
}

.language-selector:not([open]) > .nav-links {
    display: none;
}

.nav-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    padding: 0.45rem;
    color: var(--color-muted);
    border-radius: 0.55rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
}

.nav-links a:hover {
    color: var(--color-primary-dark);
    background: #e8efe8;
}

.buscador {
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
}

#buscadorDestino {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
}

#buscadorDestino label {
    font-size: 1rem;
    font-weight: 700;
}

.destino {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 0.75rem 0.9rem;
    color: var(--color-ink);
    background: #fbfcfa;
    border: 1px solid #cbd8ce;
    border-radius: 0.65rem;
    font: inherit;
}

.destino::placeholder {
    color: #87958f;
}

.filter {
    min-width: 112px;
}

.favoritos {
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
}

.favoritos h2 {
    margin: 0 0 1.2rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    letter-spacing: -0.03em;
}

.card {
    width: min(100%, 460px);
    min-height: 150px;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
}

.nombreLugar {
    margin: 0 0 0.55rem;
    font-size: 1.25rem;
}

.nombreLugar:empty::before {
    content: "Aún no hay favoritos";
}

.textoTarjeta {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
}

.textoTarjeta:empty::before {
    content: "Los destinos que guardes aparecerán aquí.";
}

.main-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.3rem clamp(1rem, 5vw, 4rem);
    color: #e9f0eb;
    background: var(--color-primary-dark);
}

.foot-section,
.foot-div {
    display: flex;
    align-items: center;
}

.foot-div {
    gap: 0.75rem;
}

.foot-div a {
    display: none;
}

.terminos-politica {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.5rem;
}

.terminos-politica p {
    margin: 0;
    color: #e9f0eb;
    font-size: 0.85rem;
}

.form_login {
    display: none;
}

@media (max-width: 760px) {
    .cabecera {
        flex-wrap: wrap;
        gap: 0.7rem;
        padding: 0.8rem 1rem;
    }

    .cabecera > img {
        width: 40px;
        height: 40px;
    }

    .logo {
        margin-right: auto;
        font-size: 1.15rem;
    }

    .menu {
        order: 3;
        justify-content: flex-start;
        width: 100%;
        gap: clamp(0.85rem, 4vw, 1.8rem);
        margin: 0;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .menu a {
        flex: 0 0 auto;
        font-size: 0.9rem;
    }

    .botonViaje {
        min-height: 40px;
        padding: 0.55rem 0.8rem;
        font-size: 0.9rem;
    }
}

@media (max-width: 480px) {
    main {
        width: min(100% - 1.25rem, 1080px);
        padding-top: 1.25rem;
    }

    #nav {
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .menu-toggle {
        padding-inline: 0.65rem;
        font-size: 0.82rem;
    }

    #buscadorDestino {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.65rem;
    }

    #buscadorDestino label {
        margin-bottom: 0.1rem;
    }

    .filter {
        width: 100%;
    }

    .card {
        min-height: 135px;
    }

    .main-footer {
        align-items: flex-start;
        flex-direction: column;
        padding: 1.25rem;
    }

    .terminos-politica {
        justify-content: flex-start;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}




